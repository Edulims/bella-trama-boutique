# ──────────────────────────────────────────────
#  Simplifica.IA — .gitignore
# ──────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
build/
dist/

# Vercel
.vercel

# Production runtime files
*.tsbuildinfo
next-env.d.ts.bak

# Environment variables (NUNCA commitar)
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
.env*.local

# Prisma — banco SQLite local (gerado pelo seed)
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal
prisma/migrations/**/migration_lock.toml.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# Coverage / testes
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
.playwright/

# Editores e SO
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo

# Claude Code — preserva agente e skills, ignora estado local
.claude/settings.local.json
.claude/.local/
.claude/cache/

# Misc
*.pem
.eslintcache
.cache/
.parcel-cache/
.turbo/
