# ─────────────────────────────────────────────────
#  Simplifica.IA — Template de variáveis de ambiente
#  Copie este arquivo para .env e preencha os valores
#    PowerShell:  Copy-Item .env.example .env
#    Bash/macOS:  cp .env.example .env
# ─────────────────────────────────────────────────

# Banco de dados (modo "Demo Local Polida" — SQLite local)
DATABASE_URL="file:./dev.db"

# ────── Próximas variáveis (só quando houver cliente real) ──────

# Postgres (Neon/Supabase/Railway) — substitui DATABASE_URL acima quando subir prod
# DATABASE_URL="postgresql://user:password@host:5432/simplifica_ia?sslmode=require"

# NextAuth / Auth.js v5 (quando implementar autenticação)
# NEXTAUTH_SECRET="gere com: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
# NEXTAUTH_URL="http://localhost:3000"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# ALLOWED_EMAIL=""

# Anthropic (quando substituir mockInsights por Claude API real)
# ANTHROPIC_API_KEY=""
