# ─────────────────────────────────────────────────
#  Simplifica.IA — Template de variáveis de ambiente
#  Copie este arquivo para .env e preencha os valores
#    PowerShell:  Copy-Item .env.example .env
#    Bash/macOS:  cp .env.example .env
# ─────────────────────────────────────────────────

# Banco de dados
# Local (SQLite, padrão para desenvolvimento):
DATABASE_URL="file:./dev.db"

# Produção (PostgreSQL — recomendado: Neon, Supabase ou Railway):
# DATABASE_URL="postgresql://user:password@host:5432/simplifica_ia?sslmode=require"

# ────── Próximas variáveis (ainda não usadas no MVP) ──────

# NextAuth / Auth.js (quando implementar autenticação)
# NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
# NEXTAUTH_URL="http://localhost:3000"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# OpenAI / Anthropic (quando integrar IA real nos Insights)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Upstash Redis (rate limiting)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Sentry (monitoramento de erros)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
